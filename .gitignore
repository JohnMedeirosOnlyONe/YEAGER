# ============================================
# YEAGER - .GitIgnore
# ============================================

# Python Cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
*.pem
*.key
secrets.json
!.env.example

# IDE and editor
.vscode/
.idea/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Build and packaging
build/
dist/
*.egg-info/

# temporary files and logs
*.log
*.tmp
*.bak

# Generated scan results
outputs/
reports/generated/
scan_results/

# Operating system
.DS_Store
Thumbs.db